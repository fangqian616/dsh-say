# Dependencies
node_modules/

# Generated audio and helper scripts
*.wav
!docs/**/*.wav
# The shipped voice pack's reference clip is committed on purpose: it is small,
# it is covered by voice/NOTICE.txt, and without it a user cannot verify the
# setup without fetching the weights first.
!voice/voice-packs/**/*.wav

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Never commit a voice pack or model weights anywhere EXCEPT the optional
# voice/ directory, which is the one place the maintainer chose to publish a
# non-commercial voice from. Everything else stays out.
*.ckpt
*.pth
*.safetensors
# Root-anchored: an unanchored `voice-packs/` also matches voice/voice-packs/,
# which is exactly the directory this repository means to ship.
/voice-packs/
!voice/GPT_weights_*/*.ckpt
!voice/SoVITS_weights_*/*.pth
# The shipped pack is small, licensed by voice/NOTICE.txt, and without it a
# user cannot verify the setup before fetching hundreds of megabytes.
!voice/voice-packs/**

# A fetched weight archive stays local; users run the fetch script themselves.
voice/*.zip

# Repository-local, never published: drives a private voice pack on the
# maintainer's own machine for pre-release testing. Ships no data itself.
/local/

# Commit messages written to a file, because a heredoc is not available in every
# shell this project is developed from. Never content.
/COMMIT_MSG.txt
/MSG.txt
